<?xml version="1.0"?>
<sdf version="1.9">
  <world name="hri_assignment">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.5 0.2 -1</direction></light>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="work_table"><static>true</static><pose>0.47 0 0.03 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.56 0.65 0.06</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.56 0.65 0.06</size></box></geometry><material><ambient>0.42 0.25 0.12 1</ambient><diffuse>0.52 0.32 0.16 1</diffuse></material></visual></link></model>
    <!-- Cubes are intentionally visual-only in Gazebo.  Their full 50 mm box
         collisions live in the MoveIt PlanningScene.  A selected cube is
         attached there only after the real simulated fingers close, while its
         Gazebo model follows gripper_tcp.  This avoids an immovable static cube
         blocking the 2F-85 mimic linkage during the close animation. -->
    <model name="red_cube"><static>true</static><pose>0.25 -0.20 0.085 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>1 0.02 0.02 1</ambient><diffuse>1 0.02 0.02 1</diffuse></material></visual></link></model>
    <model name="yellow_cube"><static>true</static><pose>0.25 0 0.085 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>1 0.8 0.02 1</ambient><diffuse>1 0.8 0.02 1</diffuse></material></visual></link></model>
    <model name="blue_cube"><static>true</static><pose>0.25 0.20 0.085 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.02 0.1 1 1</ambient><diffuse>0.02 0.1 1 1</diffuse></material></visual></link></model>
    <!-- The zones are visual-only open trays.  Keeping their model origins at
         the original target coordinates means the motion logic remains
         unchanged.  The letters are built from box strokes so they render
         reliably without depending on a particular Gazebo font package. -->
    <model name="zone_a">
      <static>true</static>
      <pose>0.38 -0.12 0.062 0 0 0</pose>
      <link name="link">
        <visual name="floor"><geometry><box><size>0.09 0.09 0.004</size></box></geometry><material><ambient>0.75 0.04 0.04 1</ambient><diffuse>0.9 0.06 0.06 1</diffuse></material></visual>
        <visual name="wall_x_pos"><pose>0.042 0 0.009 0 0 0</pose><geometry><box><size>0.006 0.09 0.018</size></box></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>1 0.08 0.08 1</diffuse></material></visual>
        <visual name="wall_x_neg"><pose>-0.042 0 0.009 0 0 0</pose><geometry><box><size>0.006 0.09 0.018</size></box></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>1 0.08 0.08 1</diffuse></material></visual>
        <visual name="wall_y_pos"><pose>0 0.042 0.009 0 0 0</pose><geometry><box><size>0.078 0.006 0.018</size></box></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>1 0.08 0.08 1</diffuse></material></visual>
        <visual name="wall_y_neg"><pose>0 -0.042 0.009 0 0 0</pose><geometry><box><size>0.078 0.006 0.018</size></box></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>1 0.08 0.08 1</diffuse></material></visual>
        <!-- Label A, positioned to the +x side of the tray. -->
        <visual name="label_a_left"><pose>0.066 -0.0045 0.0025 0 0 0.27</pose><geometry><box><size>0.034 0.004 0.003</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.15 0.15 0.15 1</emissive></material></visual>
        <visual name="label_a_right"><pose>0.066 0.0045 0.0025 0 0 -0.27</pose><geometry><box><size>0.034 0.004 0.003</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.15 0.15 0.15 1</emissive></material></visual>
        <visual name="label_a_bar"><pose>0.063 0 0.0025 0 0 0</pose><geometry><box><size>0.004 0.017 0.003</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.15 0.15 0.15 1</emissive></material></visual>
      </link>
    </model>

    <model name="zone_b">
      <static>true</static>
      <pose>0.38 0 0.062 0 0 0</pose>
      <link name="link">
        <visual name="floor"><geometry><box><size>0.09 0.09 0.004</size></box></geometry><material><ambient>0.8 0.62 0.02 1</ambient><diffuse>1 0.82 0.04 1</diffuse></material></visual>
        <visual name="wall_x_pos"><pose>0.042 0 0.009 0 0 0</pose><geometry><box><size>0.006 0.09 0.018</size></box></geometry><material><ambient>0.8 0.62 0.02 1</ambient><diffuse>1 0.82 0.04 1</diffuse></material></visual>
        <visual name="wall_x_neg"><pose>-0.042 0 0.009 0 0 0</pose><geometry><box><size>0.006 0.09 0.018</size></box></geometry><material><ambient>0.8 0.62 0.02 1</ambient><diffuse>1 0.82 0.04 1</diffuse></material></visual>
        <visual name="wall_y_pos"><pose>0 0.042 0.009 0 0 0</pose><geometry><box><size>0.078 0.006 0.018</size></box></geometry><material><ambient>0.8 0.62 0.02 1</ambient><diffuse>1 0.82 0.04 1</diffuse></material></visual>
        <visual name="wall_y_neg"><pose>0 -0.042 0.009 0 0 0</pose><geometry><box><size>0.078 0.006 0.018</size></box></geometry><material><ambient>0.8 0.62 0.02 1</ambient><diffuse>1 0.82 0.04 1</diffuse></material></visual>
        <!-- Label B. -->
        <visual name="label_b_spine"><pose>0.066 -0.009 0.0025 0 0 0</pose><geometry><box><size>0.036 0.004 0.003</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="label_b_top"><pose>0.082 0 0.0025 0 0 0</pose><geometry><box><size>0.004 0.022 0.003</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="label_b_middle"><pose>0.066 0 0.0025 0 0 0</pose><geometry><box><size>0.004 0.022 0.003</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="label_b_bottom"><pose>0.050 0 0.0025 0 0 0</pose><geometry><box><size>0.004 0.022 0.003</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="label_b_right_top"><pose>0.074 0.009 0.0025 0 0 0</pose><geometry><box><size>0.016 0.004 0.003</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="label_b_right_bottom"><pose>0.058 0.009 0.0025 0 0 0</pose><geometry><box><size>0.016 0.004 0.003</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <model name="zone_c">
      <static>true</static>
      <pose>0.38 0.12 0.062 0 0 0</pose>
      <link name="link">
        <visual name="floor"><geometry><box><size>0.09 0.09 0.004</size></box></geometry><material><ambient>0.03 0.12 0.75 1</ambient><diffuse>0.05 0.2 1 1</diffuse></material></visual>
        <visual name="wall_x_pos"><pose>0.042 0 0.009 0 0 0</pose><geometry><box><size>0.006 0.09 0.018</size></box></geometry><material><ambient>0.03 0.12 0.75 1</ambient><diffuse>0.05 0.2 1 1</diffuse></material></visual>
        <visual name="wall_x_neg"><pose>-0.042 0 0.009 0 0 0</pose><geometry><box><size>0.006 0.09 0.018</size></box></geometry><material><ambient>0.03 0.12 0.75 1</ambient><diffuse>0.05 0.2 1 1</diffuse></material></visual>
        <visual name="wall_y_pos"><pose>0 0.042 0.009 0 0 0</pose><geometry><box><size>0.078 0.006 0.018</size></box></geometry><material><ambient>0.03 0.12 0.75 1</ambient><diffuse>0.05 0.2 1 1</diffuse></material></visual>
        <visual name="wall_y_neg"><pose>0 -0.042 0.009 0 0 0</pose><geometry><box><size>0.078 0.006 0.018</size></box></geometry><material><ambient>0.03 0.12 0.75 1</ambient><diffuse>0.05 0.2 1 1</diffuse></material></visual>
        <!-- Label C. -->
        <visual name="label_c_spine"><pose>0.066 -0.009 0.0025 0 0 0</pose><geometry><box><size>0.036 0.004 0.003</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.15 0.15 0.15 1</emissive></material></visual>
        <visual name="label_c_top"><pose>0.082 0 0.0025 0 0 0</pose><geometry><box><size>0.004 0.022 0.003</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.15 0.15 0.15 1</emissive></material></visual>
        <visual name="label_c_bottom"><pose>0.050 0 0.0025 0 0 0</pose><geometry><box><size>0.004 0.022 0.003</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.15 0.15 0.15 1</emissive></material></visual>
      </link>
    </model>
  </world>
</sdf>
